# Copy to .env (install.sh does this for you and fills in random secrets).
# NEVER commit .env.

POSTGRES_PASSWORD=change-me
# Signs login tokens. Long random string.
SECRET_KEY=change-me
# Fernet key(s) for encrypting CNIC. Generate:  openssl rand -base64 32 | tr '+/' '-_'
# Comma-separate several keys to rotate (first encrypts, all decrypt). LOSING THIS KEY MAKES
# ENCRYPTED CNIC DATA UNRECOVERABLE: it is included in encrypted backups, keep a copy elsewhere too.
FIELD_ENCRYPTION_KEYS=change-me

# First-run super admin (only used if no users exist). Remove the password line after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Reverse proxy. See Caddyfile for examples.
SITE_ADDRESS=:80
CADDY_TLS=

TIMEZONE=Asia/Karachi

# Billing. What does the Wasooli "Recharge Date" mean?
#   NEXT_DUE       = the date the customer's next payment is due
#   LAST_RECHARGE  = the date the customer last paid (next due = one month later)
RECHARGE_DATE_MEANS=NEXT_DUE
# A cycle is invoiced when its due date is within this many days.
BILLING_LEAD_DAYS=5
# Late fees are OFF while the amount is 0. Flat fee per overdue invoice, charged once.
LATE_FEE_AMOUNT=0
LATE_FEE_GRACE_DAYS=5
LATE_FEE_DUE_DAYS=7
ENABLE_DOCS=false

# Backups are always encrypted with this passphrase. Store it somewhere safe OUTSIDE this server.
BACKUP_PASSPHRASE=change-me

# Printed at the top of receipts, invoices and statements.
COMPANY_NAME=Your ISP Name
COMPANY_PHONE=
COMPANY_ADDRESS=
